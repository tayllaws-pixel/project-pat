# /etc/project-pat/inference/ollama.env  (installed into CT 101, consumed by the ollama systemd drop-in)
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_MODELS=/var/lib/ollama/models
OLLAMA_MAX_LOADED_MODELS=3        # embeddings + up to two large (ADR-0006 policy); the shim enforces VRAM
OLLAMA_NUM_PARALLEL=2
OLLAMA_KEEP_ALIVE=30m             # background models are evicted sooner by the priority shim
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0         # halves KV cache VRAM at negligible quality cost; benchmark confirms
